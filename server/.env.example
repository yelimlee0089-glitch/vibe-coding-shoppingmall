# 배포(Heroku)에서는 PORT 를 Heroku 가 자동으로 정해 주므로 설정하지 않음
# NODE_ENV=production 으로 설정해야 쿠키가 HTTPS 전용이 되고 모의 결제가 차단됨
PORT=5000
# MongoDB 주소 (예: Atlas 의 mongodb+srv://...). 비워 두면 로컬 mongodb://127.0.0.1:27017/shoppingmall 사용
MONGODB_URI=
CLIENT_URL=http://localhost:5173
# 토큰 서명용 비밀 키 (길고 랜덤한 문자열, 절대 공개 금지)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 포트원(아임포트) REST API 키 (관리자 콘솔 > 결제 연동 > 식별코드·API Keys). 절대 공개 금지
# 비워 두면 개발 환경에서는 모의 결제로 동작
PORTONE_API_KEY=
PORTONE_API_SECRET=
# 테스트 채널(KG이니시스 INIpayTest 등) 결제도 인정할지. 실제 서비스(운영)에서는 반드시 false
PORTONE_ALLOW_SANDBOX=false
