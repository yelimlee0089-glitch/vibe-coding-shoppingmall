# API 기본 경로: 개발은 Vite 프록시, 배포(Vercel)는 vercel.json 의 rewrites 가 /api 를 Heroku 로 전달
# → 두 경우 모두 /api 그대로 두면 됨 (로그인 쿠키가 같은 사이트 쿠키로 동작)
VITE_API_BASE_URL=/api

# Cloudinary 업로드 위젯 (Cloudinary 콘솔 > Settings > Upload 에서 Unsigned 프리셋 생성)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# 포트원(아임포트) 고객사 식별코드 (관리자 콘솔 > 결제 연동 > 식별코드)
VITE_PORTONE_IMP_CODE=imp00000000
# 사용할 PG 채널 (포트원 콘솔에 등록된 채널, 기본: KG이니시스 테스트)
VITE_PORTONE_PG=html5_inicis.INIpayTest
